# ==============================================================================
# HUB HOSPITALARIO - PLANTILLA DE VARIABLES DE ENTORNO
# Copie este archivo como .env.local para su entorno local:
#   cp .env.example apps/hub/.env.local
#
# IMPORTANTE: NUNCA ingrese contraseñas, claves ni tokens reales en este archivo
# ni lo commitee con valores sensibles al repositorio.
# ==============================================================================

# Backend PocketBase (Servidor y API en tiempo real)
NEXT_PUBLIC_POCKETBASE_URL=https://pocketbase.ejemplo.gob.ar

# Credenciales de Administrador / Superuser de PocketBase
# Utilizadas exclusivamente por rutas del servidor (API routes) para tareas administrativas
POCKETBASE_ADMIN_EMAIL=admin@hospital.gob.ar
POCKETBASE_ADMIN_PASSWORD=su_contraseña_segura_de_administrador

# Servicio de Correo Electrónico Transaccional (Resend)
RESEND_API_KEY=re_su_api_key_de_resend_aqui
RESEND_FROM_EMAIL=Hub Hospitalario <no-reply@notificaciones.hospital.gob.ar>

# Clave Secreta para Firma y Verificación de Tokens JWT Internos
# En producción, use una cadena pseudoaleatoria de alta entropía (mínimo 64 caracteres)
JWT_SECRET=clave_secreta_jwt_minimo_64_caracteres_aleatorios_aqui

# URL Base Pública de la Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Umami Analytics (Opcional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
UMAMI_API_URL=
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
